#!/bin/sh
# Early, local version of the repository rules (MVP 2, 5.1): no direct pushes to develop, test or main, and new
# branches are named feature/<name> or fix/<name>. GitHub enforces the same rules on the server.
# Enable hooks once per clone:  git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  name=${remote_ref#refs/heads/}
  case "$remote_ref" in
    refs/heads/main | refs/heads/test | refs/heads/develop)
      echo "pre-push: direct pushes to '$name' are not allowed. Open a pull request instead."
      exit 1 ;;
    refs/heads/feature/* | refs/heads/fix/*) ;;
    refs/heads/*)
      echo "pre-push: branch '$name' isn't allowed. Name it feature/<name> (a new feature) or fix/<name> (a bug fix)."
      exit 1 ;;
  esac
done

exit 0
